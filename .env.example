# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional: Google AI Studio key for photo category suggestions
GEMINI_API_KEY=
# Set to 1 when served over HTTPS
COOKIE_SECURE=0
# Optional: PostgreSQL URL for deployment
# DATABASE_URL=postgresql://user:pass@host/dbname

# --- Admins & sign-in limits ---
ADMIN_LIMIT=4
LOGIN_LIMIT=15 per 15 minutes
# --- Forgot password ---
# Public site address used inside reset emails, e.g. https://civicsense.onrender.com
PUBLIC_URL=
# Email sending. Gmail example:
#   SMTP_HOST=smtp.gmail.com   SMTP_PORT=587
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASSWORD=your 16-character Google App Password (not your normal password)
#   SMTP_FROM=yourname@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# DEMO ONLY: 1 = show the reset link on screen instead of emailing it. Never use on a public site.
SHOW_RESET_LINK=0
